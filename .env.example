# Telegram
BOT_TOKEN=123456:ABC-DEF_your_botfather_token_here

# Google service account — path INSIDE the container (mounted via docker-compose)
GOOGLE_SERVICE_ACCOUNT_FILE=/app/service_account.json

# PostgreSQL — single source of truth for the DB password.
# docker-compose derives the bot's DATABASE_URL from this value, so you only
# set it in one place.
POSTGRES_PASSWORD=CHANGE_ME
#
# ⚠️ GOTCHA: docker compose resolves ${POSTGRES_PASSWORD} from your SHELL
# environment FIRST, then this file. If you have POSTGRES_PASSWORD exported in
# your shell (e.g. ~/.zprofile), that value wins for BOTH containers — which is
# fine as long as it's consistent. If you hit "password authentication failed",
# either `unset POSTGRES_PASSWORD` in your shell or make them match, then wipe
# the db volume: `docker compose down -v`.
#
# Only set DATABASE_URL manually if running WITHOUT docker compose:
# DATABASE_URL=postgresql://expense_bot:CHANGE_ME@db:5432/expense_bot

# Where Postgres stores its data.
#   Server → uncomment to use the attached persistent volume:
# POSTGRES_DATA_DIR=/mnt/cram-data/finance/postgres
#   Local  → leave unset to use the Docker named volume `pgdata`.

# Timezone for "today"/timestamps (IANA name). Defaults to Europe/Belgrade.
BOT_TIMEZONE=Europe/Belgrade

# Exchange rates (no key needed — base endpoint)
EXCHANGE_RATE_BASE_URL=https://open.er-api.com/v6/latest

# Optional: template sheet users copy during onboarding
TEMPLATE_SHEET_URL=https://docs.google.com/spreadsheets/d/your_template_id/copy
